          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{temperatureUrl}}/temperature/555",
              "host": [
                "{{temperatureUrl}}"
              ],
              "path": [
                "temperature",
                "555"
              ],
              "query": [
                {
                  "key": "location",
                  "value": "banya",
                  "disabled": true
