@startuml
title Device Gateway — C4 Component Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

System_Ext(devices, "Devices", "Устройства: отопление, свет, ворота, камеры, датчики")
System_Ext(extTempApi, "External Temperature API", "Получение температуры")
ContainerQueue(mqtt, "MQTT-брокер", "MQTT", "Шина для работы с устройствами")
ContainerQueue(kafka, "Message Broker", "Kafka", "Регистрация устройств, команды, телеметрия и результаты")

Container_Boundary(devGw, "Device Gateway") {
  Component(devRegistry, "Device Registry", "C# / Kafka consumer", "Реестр зарегистрированных устройств")
  Component(commandDispatcher, "Command Dispatcher", "Kafka / BackgroundService", "Получает команды")
  Component(acl, "Anti-Corruption Layer. Протоколы девайсов не проникают в домен", "C# / MQTT.NET", "Транслирует универсальные команды в протокол устройства")
  Component(extTempAdaptor, "External Temperature Adapter", "BackgroundService", "Запросы в External Temperature API")
}

Rel(devices, mqtt, "Устанавливают соединение. Отправляют показания", "MQTT")
Rel(mqtt, devices, "Отправляет команды в устройства", "MQTT")
Rel(kafka, devRegistry, "События регистрации\удаления устройств", "Kafka")
Rel(mqtt, devRegistry, "Проверка доступа", "MQTT")
Rel(devRegistry, mqtt, "Отключает устройство", "MQTT")
Rel(kafka, commandDispatcher, "Отправляет команды", "Kafka")
Rel(commandDispatcher, devRegistry, "Проверяет регистрацию и находит устройство")
Rel(commandDispatcher, acl, "Передаёт команду в ACL")
Rel(commandDispatcher, extTempAdaptor, "Передаёт команду на получение температуры")
Rel(acl, mqtt, "Публикует команды в MQTT", "MQTT")
Rel(mqtt, acl, "Статусы команд", "MQTT")
Rel(acl, kafka, "Передаёт сообщения от девайсов в Kafka")
Rel(extTempAdaptor, devRegistry, "Получает рауты для внешних провайдеров, таких как Temperature API")
Rel(extTempAdaptor, extTempApi, "Запрашивает температуру", "HTTPS / REST")
Rel(extTempAdaptor, kafka, "Передаёт показания T в Kafka")

@enduml
